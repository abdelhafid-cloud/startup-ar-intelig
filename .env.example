# Copiez vers .env (local) — sur Vercel : mêmes noms dans Environment Variables + Redeploy

VITE_EMAILJS_SERVICE_ID=service_xxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_TEMPLATE_ID=template_ceo_xxxxx
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=template_client_xxxxx

# Boîte qui reçoit les demandes de démo
VITE_EMAILJS_TO_EMAIL=your-ceo-inbox@company.com

# En prod : URL du site déployé (pas localhost)
VITE_SITE_URL=https://your-project.vercel.app

# Optionnel — logo hébergé ailleurs (sinon /startup-logos/AR.png sur VITE_SITE_URL)
VITE_LOGO_URL=
