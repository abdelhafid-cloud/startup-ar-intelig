# EmailJS — 2 e-mails par formulaire : CEO (demande) + client (confirmation)

VITE_EMAILJS_SERVICE_ID=service_xxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# E-mail du CEO (reçoit les demandes de démo) — obligatoire aussi sur Vercel
VITE_EMAILJS_TO_EMAIL=ceo@arintelligence.ai
# ou : VITE_EMAILJS_CEO_EMAIL=ceo@arintelligence.ai

# Template 1 : notification CEO → HTML demo-request.html → To Email = {{to_email}}
VITE_EMAILJS_TEMPLATE_ID=template_xxxxx

# Template 2 : confirmation client → HTML demo-confirmation.html → To Email = {{user_email}}
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=template_auto_reply_xxxxx

# Logo (imgbb ou VITE_SITE_URL si site déployé)
VITE_LOGO_URL=
VITE_SITE_URL=https://your-project.vercel.app
